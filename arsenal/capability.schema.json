{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-arsenal.dev/schema/capability-fragment-2.0.0.json",
  "title": "Project Arsenal Capability Fragment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "capability"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "capability": {"$ref": "#/$defs/capability"}
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "required", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "required": {"type": "boolean"},
        "description": {"type": "string", "minLength": 8}
      }
    },
    "namedDescription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "description": {"type": "string", "minLength": 8}
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "description": {"type": "string", "minLength": 8}
      }
    },
    "discoveryStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 8},
        "kind": {"enum": ["positive", "negative"]}
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_when"],
      "properties": {
        "use_when": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/discoveryStatement"}
        },
        "do_not_use_when": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/discoveryStatement"}
        }
      }
    },
    "authority": {
      "enum": [
        "filesystem.read", "filesystem.write", "shell.execute",
        "network.read", "network.write", "git.read", "git.write",
        "tracker.read", "tracker.write", "secrets.read", "cloud.local",
        "cloud.remote", "production.mutate", "human.confirmation"
      ]
    },
    "substrate": {
      "enum": [
        "reasoning-only", "repository-read", "local-process",
        "local-container", "local-emulator", "local-cluster",
        "remote-sandbox", "shared-nonproduction", "staging",
        "production", "user-mediated"
      ]
    },
    "verificationRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "evidence_kind"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
        "description": {"type": "string", "minLength": 8},
        "evidence_kind": {
          "enum": ["report", "artifact", "command", "test", "diff", "receipt", "decision-record", "runtime-observation", "verdict"]
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "display_name", "aliases", "purpose",
        "lifecycle", "invocation", "discovery", "inputs", "outputs",
        "preconditions", "context", "implementation", "authority",
        "mutation", "execution", "verification", "evidence_outputs",
        "evaluation", "provenance", "compatibility"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^capability\\.[a-z][a-z0-9.-]*$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "display_name": {"type": "string", "minLength": 2},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "purpose": {"type": "string", "minLength": 12},
        "lifecycle": {"enum": ["draft", "testing", "stable", "deprecated"]},
        "invocation": {"enum": ["human", "agent", "composed"]},
        "discovery": {"$ref": "#/$defs/discovery"},
        "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/input"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/namedDescription"}},
        "preconditions": {"type": "array", "items": {"$ref": "#/$defs/precondition"}},
        "context": {
          "type": "object", "additionalProperties": false, "required": ["required", "preferred"],
          "properties": {
            "required": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}},
            "preferred": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
          }
        },
        "implementation": {
          "type": "object", "additionalProperties": false, "required": ["primary_asset", "asset_ids"],
          "properties": {
            "primary_asset": {"type": "string", "minLength": 3},
            "asset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
          }
        },
        "authority": {
          "type": "object", "additionalProperties": false, "required": ["required", "optional", "forbidden"],
          "properties": {
            "required": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/authority"}},
            "optional": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/authority"}},
            "forbidden": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/authority"}}
          }
        },
        "mutation": {
          "type": "object", "additionalProperties": false, "required": ["class", "reversible"],
          "properties": {
            "class": {"enum": ["read-only", "workspace-write", "external-write", "high-consequence"]},
            "reversible": {"type": "boolean"}
          }
        },
        "execution": {
          "type": "object", "additionalProperties": false, "required": ["preferred", "allowed", "prohibited"],
          "properties": {
            "preferred": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/substrate"}},
            "allowed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/substrate"}},
            "prohibited": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/substrate"}}
          }
        },
        "verification": {
          "type": "object", "additionalProperties": false, "required": ["requirements", "receipt_required"],
          "properties": {
            "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/verificationRequirement"}},
            "receipt_required": {"type": "boolean"}
          }
        },
        "evidence_outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/namedDescription"}},
        "evaluation": {
          "type": "object", "additionalProperties": false, "required": ["status", "suite_asset_ids"],
          "properties": {
            "status": {"enum": ["unassessed", "planned", "candidate", "qualified"]},
            "suite_asset_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
          }
        },
        "provenance": {
          "type": "object", "additionalProperties": false, "required": ["asset_ids"],
          "properties": {"asset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}}
        },
        "compatibility": {
          "type": "object", "additionalProperties": false, "required": ["supersedes", "notes"],
          "properties": {
            "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^capability\\.[a-z][a-z0-9.-]*$"}},
            "notes": {"type": "string"}
          }
        }
      }
    }
  }
}
