{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-arsenal.dev/schema/flight-record-1.0.0.json",
  "title": "Project Arsenal Flight Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "run",
    "subject",
    "provenance",
    "authority",
    "context",
    "tools",
    "evidence",
    "timeline",
    "outcome",
    "privacy",
    "telemetry_mapping"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_kind": {"const": "arsenal-flight-record"},
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "fingerprint", "kind", "status"],
      "properties": {
        "instance_id": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "kind": {"enum": ["capability-verification", "evaluation"]},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNKNOWN"]}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities", "route_id", "suite_id"],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {"type": "string", "pattern": "^capability\\."},
              "version": {"type": ["string", "null"]}
            }
          }
        },
        "route_id": {"type": ["string", "null"]},
        "suite_id": {"type": ["string", "null"]}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_sha", "model", "harness", "adapter"],
      "properties": {
        "repository_sha": {"type": "string", "minLength": 1},
        "model": {"$ref": "#/$defs/runtimeIdentity"},
        "harness": {"$ref": "#/$defs/runtimeIdentity"},
        "adapter": {"$ref": "#/$defs/runtimeIdentity"}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "required", "granted", "missing", "remote_credentials_used", "human_confirmation"],
      "properties": {
        "profile": {"type": ["string", "null"]},
        "required": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "granted": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "missing": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "remote_credentials_used": {"type": "boolean"},
        "human_confirmation": {"enum": ["not-required", "granted", "denied", "not-observed"]}
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_recording", "sources", "token_volume"],
      "properties": {
        "content_recording": {"const": "metadata-only"},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id", "digest", "bytes"],
            "properties": {
              "kind": {"type": "string"},
              "id": {"type": "string"},
              "digest": {"type": ["string", "null"]},
              "bytes": {"type": ["integer", "null"], "minimum": 0}
            }
          }
        },
        "token_volume": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "input_tokens", "output_tokens"],
          "properties": {
            "status": {"enum": ["observed", "not-observed", "not-applicable"]},
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0}
          }
        }
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "version", "result", "evidence_ids"],
        "properties": {
          "id": {"type": "string"},
          "role": {"type": "string"},
          "version": {"type": ["string", "null"]},
          "result": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "source", "sha256", "accepted", "claim_scope", "limitations"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "source": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "accepted": {"type": "boolean"},
          "claim_scope": {"type": "string"},
          "limitations": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "event_name", "category", "status", "evidence_ids"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "event_name": {"type": "string", "pattern": "^arsenal\\."},
          "category": {"enum": ["start", "decision", "execution", "evaluation", "evidence", "outcome"]},
          "status": {"type": "string"},
          "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict", "claim", "accepted_evidence_ids", "limitations"],
      "properties": {
        "verdict": {"enum": ["PASS", "FAIL", "BLOCKED", "UNKNOWN"]},
        "claim": {"type": "string"},
        "accepted_evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "secrets_recorded", "prompt_content_recorded", "completion_content_recorded", "chain_of_thought_recorded"],
      "properties": {
        "policy": {"const": "metadata-first-content-off"},
        "secrets_recorded": {"const": false},
        "prompt_content_recorded": {"const": false},
        "completion_content_recorded": {"const": false},
        "chain_of_thought_recorded": {"const": false}
      }
    },
    "telemetry_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "trace_name", "event_transport", "attribute_namespace", "backend_required"],
      "properties": {
        "status": {"const": "mapping-only"},
        "trace_name": {"const": "arsenal.run"},
        "event_transport": {"const": "log-based-events"},
        "attribute_namespace": {"const": "arsenal"},
        "backend_required": {"const": false}
      }
    }
  },
  "$defs": {
    "runtimeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "id", "version"],
      "properties": {
        "status": {"enum": ["observed", "not-observed", "not-applicable"]},
        "id": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]}
      }
    }
  }
}
