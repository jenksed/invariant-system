#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'validate-agent-assets: %s\n' "$1" >&2
  exit 1
}

root=$(git rev-parse --show-toplevel 2>/dev/null) || fail "not inside a Git repository"
cd "$root"

frontmatter_value() {
  local file=$1
  local key=$2

  awk -v key="$key" '
    NR == 1 && $0 == "---" { in_frontmatter = 1; next }
    in_frontmatter && $0 == "---" { exit }
    in_frontmatter && index($0, key ":") == 1 {
      sub("^[^:]+:[[:space:]]*", "")
      print
      exit
    }
  ' "$file"
}

shopt -s nullglob
skills=(.agents/skills/*/SKILL.md)
agents=(.pi/agents/*.md)
prompts=(.pi/prompts/*.md)
shopt -u nullglob

# Invocation modes describe who starts a development asset. Lifecycle status is
# an evidence claim: promotion requires recorded evaluation evidence, not
# confidence in the prose.
valid_invocation() {
  case $1 in
    agent | human | reference | composed) return 0 ;;
    *) return 1 ;;
  esac
}

valid_status() {
  case $1 in
    draft | testing | stable) return 0 ;;
    *) return 1 ;;
  esac
}

check_contract_fields() {
  local file=$1
  local kind=$2
  local invocation status

  invocation=$(frontmatter_value "$file" invocation)
  status=$(frontmatter_value "$file" status)

  [[ -n "$invocation" ]] || fail "$file has no $kind invocation mode"
  valid_invocation "$invocation" ||
    fail "$file has an invalid invocation mode: '$invocation' (use agent, human, reference, or composed)"
  [[ -n "$status" ]] || fail "$file has no $kind lifecycle status"
  valid_status "$status" ||
    fail "$file has an invalid lifecycle status: '$status' (use draft, testing, or stable)"
}

[[ ${#skills[@]} -gt 0 ]] || fail "no project skills found"
[[ ${#agents[@]} -gt 0 ]] || fail "no project specialist agents found"
[[ ${#prompts[@]} -gt 0 ]] || fail "no project prompt templates found"

for file in "${skills[@]}"; do
  directory=$(basename "$(dirname "$file")")
  name=$(frontmatter_value "$file" name)
  description=$(frontmatter_value "$file" description)

  [[ -n "$name" ]] || fail "$file has no skill name"
  [[ "$name" == "$directory" ]] || fail "$file name '$name' does not match directory '$directory'"
  [[ "$name" =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || fail "$file has an invalid skill name"
  [[ -n "$description" ]] || fail "$file has no skill description"
  check_contract_fields "$file" skill
done

for file in "${agents[@]}"; do
  name=$(frontmatter_value "$file" name)
  description=$(frontmatter_value "$file" description)
  tools=$(frontmatter_value "$file" tools)
  normalized_tools=$(printf '%s' "$tools" | tr -d '[:space:]')

  [[ -n "$name" ]] || fail "$file has no agent name"
  [[ -n "$description" ]] || fail "$file has no agent description"
  [[ -n "$tools" ]] || fail "$file has no explicit tool allowlist"

  if [[ ",$normalized_tools," == *",edit,"* || ",$normalized_tools," == *",write,"* ]]; then
    fail "$file grants a specialist agent write tools"
  fi

  check_contract_fields "$file" agent
done

required_prompts=(
  .pi/prompts/start-work.md
  .pi/prompts/review-work.md
  .pi/prompts/close-work.md
)

for file in "${required_prompts[@]}"; do
  [[ -f "$file" ]] || fail "required prompt is missing: $file"
done

invariant_file=docs/PROJECT-INVARIANTS.md
invariant_id=KILN-INV-014

[[ -f "$invariant_file" ]] || fail "project invariant file is missing: $invariant_file"
grep -Eq "^### ${invariant_id}:" "$invariant_file" ||
  fail "required development-agent invariant ${invariant_id} is missing from ${invariant_file}"

# The doctrine body is adopted from an upstream repository. This check keeps the
# version pin and the provenance record present; it does not detect drift in the
# adopted text itself.
doctrine_file=docs/ENGINEERING-DOCTRINE.md

[[ -f "$doctrine_file" ]] || fail "engineering doctrine file is missing: $doctrine_file"
grep -Eq '^Doctrine-Version: [0-9]+\.[0-9]+\.[0-9]+$' "$doctrine_file" ||
  fail "${doctrine_file} does not declare a semantic Doctrine-Version"
grep -Fqx '## Provenance and adoption' "$doctrine_file" ||
  fail "${doctrine_file} does not record upstream doctrine provenance and adoption"

doctrine_version=$(sed -n 's/^Doctrine-Version: //p' "$doctrine_file" | head -1)

printf 'validate-agent-assets: pass\n'
printf 'skills: %s\n' "${#skills[@]}"
printf 'specialist agents: %s\n' "${#agents[@]}"
printf 'prompt templates: %s\n' "${#prompts[@]}"
printf 'doctrine version: %s\n' "$doctrine_version"
