#!/usr/bin/env bash
# Read-only verifier for the project-arsenal development-agent dependency.
#
# Asserts:
#   * the submodule is initialized and points at the reviewed commit;
#   * the recorded remote URL is the canonical project-arsenal URL;
#   * the symlink at .claude/skills/repository-truth resolves inside the
#     pinned submodule to the upstream package directory;
#   * the lockfile at .claude/dependencies/project-arsenal/.arsenal.lock
#     records the reviewed plan and package digests.
#
# This script is read-only and does not modify the repository.

set -euo pipefail

fail() {
  printf 'check-project-arsenal-dependency: %s\n' "$1" >&2
  exit 1
}

root=$(git rev-parse --show-toplevel 2>/dev/null) || fail "not inside a Git repository"
cd "$root"

Pinned_Commit="ecc8797d45447060b0c4aacd8efb6b1909e9e690"
Pinned_Url="https://github.com/jenksed/project-arsenal.git"
Plan_Digest="sha256:468117f9c6397003522b62c1e7db6d4869a7cbfe0ed7614c8bb9244d9e91059d"
Package_Digest="sha256:1c6f8c72582c10d53475c0c865a2ee31fce20a2bbe7582198f510091470f3f84"

Submodule_Path=".claude/dependencies/project-arsenal"
Symlink_Path=".claude/skills/repository-truth"
Lockfile_Path="${Submodule_Path}/.arsenal.lock"

# 1. Submodule gitlink must be present in the index at mode 160000.
Index_Mode=$(git ls-files --stage "$Submodule_Path" 2>/dev/null | awk 'NR==1 { print $1; exit }')
if [[ -z "$Index_Mode" ]]; then
  fail "submodule gitlink is missing: $Submodule_Path"
fi
if [[ "$Index_Mode" != "160000" ]]; then
  fail "submodule $Submodule_Path is not a gitlink (mode $Index_Mode)"
fi

# 2. .gitmodules must declare the canonical URL.
if [[ ! -f .gitmodules ]]; then
  fail ".gitmodules is missing"
fi
grep -Fqx "	url = $Pinned_Url" .gitmodules \
  || fail ".gitmodules does not pin the canonical URL: $Pinned_Url"
grep -Fqx "[submodule \"$Submodule_Path\"]" .gitmodules \
  || fail ".gitmodules does not declare submodule $Submodule_Path"

# 3. The submodule working tree must be initialized and on the reviewed commit.
if [[ ! -d "$Submodule_Path" ]]; then
  fail "submodule working tree is not initialized at $Submodule_Path; run: git submodule update --init"
fi
if [[ ! -e "$Submodule_Path/.git" ]]; then
  fail "submodule working tree at $Submodule_Path is not a valid Git checkout"
fi
Actual_Commit=$(git -C "$Submodule_Path" rev-parse HEAD 2>/dev/null) \
  || fail "submodule $Submodule_Path HEAD could not be resolved"
if [[ "$Actual_Commit" != "$Pinned_Commit" ]]; then
  fail "submodule $Submodule_Path is at $Actual_Commit; expected pinned commit $Pinned_Commit"
fi
Actual_Url=$(git -C "$Submodule_Path" config --get remote.origin.url 2>/dev/null) \
  || fail "submodule $Submodule_Path has no remote.origin.url configured"
if [[ "$Actual_Url" != "$Pinned_Url" ]]; then
  fail "submodule $Submodule_Path remote URL is $Actual_Url; expected $Pinned_Url"
fi

# 4. The Claude skill symlink must resolve inside the pinned submodule.
if [[ ! -L "$Symlink_Path" ]]; then
  fail "expected symlink at $Symlink_Path"
fi
Resolved=$(readlink -f "$Symlink_Path" 2>/dev/null) \
  || fail "$Symlink_Path could not be resolved"
Expected_Resolved="$root/$Submodule_Path/distribution/agent-skills/repository-truth"
if [[ "$Resolved" != "$Expected_Resolved" ]]; then
  fail "$Symlink_Path resolves to $Resolved; expected $Expected_Resolved"
fi
if [[ ! -f "$Resolved/SKILL.md" ]]; then
  fail "resolved skill path is missing SKILL.md: $Resolved"
fi

# 5. The lockfile must record the reviewed plan and package digests.
if [[ ! -f "$Lockfile_Path" ]]; then
  fail "lockfile is missing: $Lockfile_Path"
fi
if ! Lockfile_Json=$(python3 - "$Lockfile_Path" <<'PY'
import json, sys
try:
    with open(sys.argv[1]) as fh:
        fh.seek(0, 2)
        size = fh.tell()
        fh.seek(0)
        data = json.load(fh)
except json.JSONDecodeError as exc:
    print(f"__invalid_json__:{exc.msg}", end="")
    sys.exit(0)
if fh is None:
    pass
print(json.dumps(data))
PY
); then
  fail "lockfile could not be parsed: $Lockfile_Path"
fi
if [[ "$Lockfile_Json" == "__invalid_json__:"* ]]; then
  Reason=${Lockfile_Json#__invalid_json__:}
  fail "lockfile is not valid JSON: $Lockfile_Path ($Reason)"
fi

Actual_Plan=$(printf '%s' "$Lockfile_Json" | python3 -c "import json,sys; print(json.load(sys.stdin).get('plan_sha256',''))")
[[ -n "$Actual_Plan" ]] || fail "lockfile does not record plan_sha256"
if [[ "$Actual_Plan" != "$Plan_Digest" ]]; then
  fail "lockfile plan_sha256 is $Actual_Plan; expected $Plan_Digest"
fi

Actual_Package=$(printf '%s' "$Lockfile_Json" | python3 -c "
import json, sys
data = json.load(sys.stdin)
for capability in data.get('capabilities', []):
    for export in capability.get('exports', []):
        if export.get('target') == 'agent-skills' and export.get('package_name') == 'repository-truth':
            print(export.get('package_sha256', ''))
            break
")
[[ -n "$Actual_Package" ]] || fail "lockfile does not record the repository-truth package digest"
if [[ "$Actual_Package" != "$Package_Digest" ]]; then
  fail "lockfile repository-truth package_sha256 is $Actual_Package; expected $Package_Digest"
fi

printf 'check-project-arsenal-dependency: pass\n'
printf 'pinned commit: %s\n' "$Actual_Commit"
printf 'remote url:    %s\n' "$Actual_Url"
printf 'plan digest:   %s\n' "$Actual_Plan"
printf 'pkg digest:    %s\n' "$Actual_Package"
printf 'skill symlink: %s -> %s\n' "$Symlink_Path" "$Resolved"
