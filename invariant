#!/usr/bin/env bash
# Invariant — monorepo developer command.
#
# Usage:
#   ./invariant status                 repository and environment overview
#   ./invariant doctor                 toolchain prerequisites check
#   ./invariant setup [product]        install project-local dependencies
#   ./invariant format TARGET [--write] check formatting; mutate only with --write
#   ./invariant check                  fast structural checks
#   ./invariant check boundaries       deterministic architecture-boundary checks
#   ./invariant test [product]         canonical validation (default: all)
#       products/profiles: arsenal loadout kiln temper temper-elixir manifold
#                          contracts integration runtime graph tooling changed
#   ./invariant run REPOSITORY         start Kiln + Temper against a repository
#   ./invariant track ...              create, test, run, or Lab-install A0/B0
#   ./invariant docs check             documentation metadata/link/source checks
#   ./invariant docs build             build static documentation HTML
#   ./invariant docs dev               run local documentation development server
#
# Root commands delegate to each product's own canonical commands; nothing
# here reimplements product logic.

set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
cd "$ROOT"

say()  { printf '%s\n' "$*"; }
fail() { printf 'invariant: %s\n' "$1" >&2; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

version_of() { # tool, args...
  local tool=$1; shift
  if have "$tool"; then
    "$tool" "$@" 2>&1 | head -1
  else
    say "MISSING"
  fi
}

cmd_status() {
  say "invariant-system monorepo"
  say "  root:    $ROOT"
  say "  branch:  $(git branch --show-current 2>/dev/null || echo '(detached)')"
  say "  commit:  $(git rev-parse --short HEAD 2>/dev/null || echo '(none)')"
  if [[ -n "$(git status --porcelain 2>/dev/null)" ]]; then
    say "  tree:    dirty"
  else
    say "  tree:    clean"
  fi
  say "products:"
  for p in arsenal loadout kiln temper temper-elixir manifold; do
    if [[ -d "products/$p" ]]; then
      say "  $p: products/$p"
    else
      say "  $p: MISSING"
    fi
  done
  say "runtimes:"
  say "  git:     $(version_of git --version)"
  say "  node:    $(version_of node --version)"
  say "  python3: $(version_of python3 --version)"
  if have elixir; then
    say "  elixir:  $(elixir --version 2>/dev/null | grep '^Elixir' || echo present)"
  else
    say "  elixir:  MISSING"
  fi
}

cmd_doctor() {
  local rc=0
  check_tool() { # name, purpose
    if have "$1"; then
      printf 'ok       %-10s %s\n' "$1" "$(version_of "$1" --version 2>/dev/null | head -c 60)"
    else
      printf 'MISSING  %-10s (%s)\n' "$1" "$2"
      rc=1
    fi
  }
  check_tool git "required"
  check_tool gh "GitHub operations"
  check_tool python3 "arsenal tooling"
  check_tool node "loadout/temper/docs"
  check_tool npm "loadout/temper/docs"
  check_tool mix "kiln"
  check_tool cc "kiln command-host helper, exqlite"
  check_tool vale "kiln prose lint (scripts/check)"
  check_tool jq "helpers"
  if have python3; then
    for mod in yaml jsonschema; do
      if python3 -c "import $mod" 2>/dev/null; then
        printf 'ok       python3:%s\n' "$mod"
      else
        printf 'MISSING  python3:%s (%s)\n' "$mod" "$([ "$mod" = yaml ] && echo 'arsenal governance tests' || echo 'kiln contract validators: pip install -r products/kiln/requirements/conformance.txt')"
        rc=1
      fi
    done
  fi
  if have elixir; then
    printf 'ok       %-10s %s\n' elixir "$(elixir --version 2>/dev/null | grep '^Elixir')"
  else
    printf 'MISSING  %-10s (%s)\n' elixir "kiln (see products/kiln/mise.toml)"
    rc=1
  fi

  # ---- M11 E5: doctor additions (read-only, no network, no credential printed) ----

  # 1. M0 packet present + DIGESTS.json parseable.
  if [[ -f contracts/m0/DIGESTS.json ]]; then
    if python3 -c 'import json,sys; json.load(open("contracts/m0/DIGESTS.json"))' 2>/dev/null; then
      printf 'ok       m0-packet    DIGESTS.json present and parseable\n'
    else
      printf 'FAIL     m0-packet    DIGESTS.json present but unparseable\n'
      rc=1
    fi
  else
    printf 'MISSING  m0-packet    contracts/m0/DIGESTS.json not present\n'
    rc=1
  fi

  # 2. Every Kiln registry script path exists (mirrors registry_paths_test).
  for regscript in products/kiln/lib/kiln/verification/command_host.ex \
                   products/kiln/lib/kiln/verification/registry.ex \
                   products/kiln/lib/kiln/verification/change.ex \
                   products/kiln/lib/kiln/verification/state.ex \
                   products/kiln/lib/kiln/verification/supervision.ex; do
    if [[ -f "$regscript" ]]; then
      printf 'ok       registry      %s\n' "$regscript"
    else
      printf 'FAIL     registry      missing %s\n' "$regscript"
      rc=1
    fi
  done

  # 3. MINIMAX_API_KEY presence only — value is NEVER printed, even
  # under `bash -x`. Credential presence is a configuration fact, NOT
  # provider health. Do not report presence as proof of live dispatch.
  #
  # The check uses two non-value-revealing constructs so the trace
  # line never expands the secret:
  #   - ${MINIMAX_API_KEY+set} returns "set" or "" based on existence
  #   - ${#MINIMAX_API_KEY} returns the byte length, not the value
  cred_present=0
  if [[ "${MINIMAX_API_KEY+set}" == "set" ]] && (( ${#MINIMAX_API_KEY} > 0 )); then
    cred_present=1
  fi
  if (( cred_present == 1 )); then
    printf 'ok       credential   MINIMAX_API_KEY present (length=%d)\n' "${#MINIMAX_API_KEY}"
  else
    printf 'note     credential   MINIMAX_API_KEY not set (live dispatch unavailable; deterministic fakes still supported)\n'
  fi

  # 4. Manifold selector test file present.
  if [[ -f products/manifold/tests/test_selector.py ]]; then
    printf 'ok       manifold      products/manifold/tests/test_selector.py present\n'
  else
    printf 'MISSING  manifold      products/manifold/tests/test_selector.py not present\n'
    rc=1
  fi

  # 5. Pinned Kiln toolchain line (products/kiln/mise.toml) vs detected
  #    Erlang / Elixir versions. Display only.
  #
  # Pinned extraction: split on the first double-quote pair after `=`.
  # This is a minimal deterministic field extraction; no fragile regex.
  pinned_erlang=$(awk -F'"' '/^erlang *=/ {print $2; exit}' products/kiln/mise.toml 2>/dev/null)
  pinned_elixir=$(awk -F'"' '/^elixir *=/ {print $2; exit}' products/kiln/mise.toml 2>/dev/null)
  #
  # Detected extraction: query the runtime directly. No banner parsing.
  # `set +e` around the call so a missing or failing elixir does not
  # abort the doctor under `set -e`/`pipefail`.
  detected_erlang=""
  detected_elixir=""
  if have elixir; then
    detected_erlang=$(set +e; elixir -e 'IO.write(System.otp_release())' 2>/dev/null)
    detected_elixir=$(set +e; elixir -e 'IO.write(System.version())' 2>/dev/null)
  fi
  printf 'info     kiln-pinned   mise.toml: erlang=%s elixir=%s; detected: erlang=%s elixir=%s\n' \
    "${pinned_erlang:-?}" "${pinned_elixir:-?}" "${detected_erlang:-?}" "${detected_elixir:-?}"

  say ""
  say "doctor does not install anything. See product READMEs for setup."
  return $rc
}

check_structure() {
  local rc=0
  note() { printf '%s\n' "$*"; }
  bad() { printf 'FAIL: %s\n' "$1"; rc=1; }

  [[ -e .git ]] || bad "no .git at monorepo root"
  [[ -x ./invariant ]] || note "warn: ./invariant is not executable"
  for f in README.md AGENTS.md invariant.boundaries.json; do
    [[ -f "$f" ]] || bad "missing root file: $f"
  done
  for p in arsenal loadout kiln temper manifold; do
    [[ -d "products/$p" ]] || bad "missing product tree: products/$p"
  done
  for d in contracts integration program; do
    [[ -d "$d" ]] || bad "missing directory: $d"
  done

  # Exactly one active Git root: no nested .git anywhere below root.
  local nested
  nested=$(find . -mindepth 2 -name .git -not -path './.git/*' 2>/dev/null | head -5)
  [[ -z "$nested" ]] || bad "nested Git roots found: $nested"

  # No submodules / gitlinks for core products.
  if git ls-files -s | awk '$1==160000' | grep -q .; then
    bad "gitlinks (submodules) present in index"
  fi
  [[ ! -f .gitmodules ]] || bad ".gitmodules present at root"
  return $rc
}

check_boundaries() {
  local rc=0
  bad() { printf 'FAIL: %s\n' "$1"; rc=1; }
  ok()  { printf 'ok:   %s\n' "$1"; }

  [[ -f invariant.boundaries.json ]] || fail "invariant.boundaries.json missing"
  python3 -c 'import json,sys; json.load(open("invariant.boundaries.json"))' \
    || fail "invariant.boundaries.json is not valid JSON"

  # 1. No nested Git roots.
  if [[ -z "$(find . -mindepth 2 -name .git -not -path './.git/*' 2>/dev/null)" ]]; then
    ok "single Git root"
  else
    bad "nested .git directories found"
  fi

  # 2. No submodules.
  if git ls-files -s | awk '$1==160000' | grep -q .; then
    bad "gitlinks present (submodules are not used for core products)"
  else
    ok "no submodules"
  fi

  # 3. Manifold is a selection-only boundary. Activated surface (BT-01):
  # `src/selector.py` + `tests/test_selector.py`. Every other tracked file
  # under `products/manifold/` must be `*.md`. The selector source must be
  # stdlib-only (no subprocess/socket/HTTP/asyncio/ctypes/os imports) and
  # must not reach into sibling product source trees.
  local manifold_files
  manifold_files=$(git ls-files products/manifold 2>/dev/null || true)
  if [[ -n "$manifold_files" ]]; then
    # Allow only *.md, src/selector.py, tests/test_selector.py under products/manifold.
    local bad_files=()
    while IFS= read -r f; do
      case "$f" in
        *.md|products/manifold/src/selector.py|products/manifold/tests/test_selector.py) ;;
        *) bad_files+=("$f") ;;
      esac
    done <<< "$manifold_files"
    if (( ${#bad_files[@]} > 0 )); then
      bad "products/manifold has files outside the activated selection surface: ${bad_files[*]}"
    fi
    # Activated source must not import subprocess/socket/urllib/requests/
    # http.client/asyncio/multiprocessing/ctypes/os — selection is pure
    # stdlib data in/out with no process/network/environment surface.
    local bad_imports
    bad_imports=$(rg -n 'subprocess|socket|urllib|requests|http\.client|asyncio|multiprocessing|ctypes|import\s+os\b' \
      -g 'products/manifold/src/**' -g 'products/manifold/tests/**' \
      products/manifold 2>/dev/null || true)
    if [[ -n "$bad_imports" ]]; then
      bad "products/manifold src/tests imports non-stdlib or process/network surface: $bad_imports"
    fi
    # Activated source must not reach into sibling product trees.
    local bad_coupling
    bad_coupling=$(rg -n 'products/(arsenal|loadout|kiln|temper)' \
      -g 'products/manifold/src/**' -g 'products/manifold/tests/**' \
      products/manifold 2>/dev/null || true)
    if [[ -n "$bad_coupling" ]]; then
      bad "products/manifold src/tests references sibling product trees: $bad_coupling"
    fi
    ok "manifold is selection-only (src/selector.py + tests)"
  else
    ok "manifold is selection-only (no activated surface files yet)"
  fi

  # 4. Temper presents and operates; it must not reach into sibling product trees.
  if rg -q 'products/(arsenal|loadout|kiln|manifold)|\.\./\.\./(arsenal|loadout|kiln)' products/temper/src 2>/dev/null; then
    bad "temper src references sibling product trees"
  else
    ok "temper has no sibling-product source coupling"
  fi

  # 4b. The experimental Elixir Temper surface is still a product boundary.
  # A path dependency or source reference into Kiln makes tests pass by
  # compilation coupling rather than by a canonical contract/public API.
  if [[ -d products/temper-elixir ]]; then
    local temper_elixir_coupling
    temper_elixir_coupling=$(rg -n '(path:[[:space:]]*"\.\./kiln"|\.\./kiln|products/kiln)' \
      products/temper-elixir/mix.exs products/temper-elixir/lib 2>/dev/null || true)
    if [[ -n "$temper_elixir_coupling" ]]; then
      bad "temper-elixir references Kiln source directly: $temper_elixir_coupling"
    else
      ok "temper-elixir has no sibling-product source coupling"
    fi
  fi

  # 5. Canonical contracts live exactly once, at contracts/.
  local c count
  for c in work-envelope.v0.md run-result-envelope.v0.md qualified-method-record.v0.md learning-observation.v0.md; do
    count=$(git ls-files | grep -c "/$c\|^$c" || true)
    if [[ "$count" -eq 1 && -f "contracts/$c" ]]; then
      ok "contract canonical: contracts/$c"
    else
      bad "contract $c: expected exactly one canonical copy at contracts/ (found $count)"
    fi
  done

  return $rc
}

