#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"
guard_endpoint
mkdir -p "$ARTIFACT_DIR"
trap 'compose logs >"$ARTIFACT_DIR/floci-az.log" 2>&1 || true' EXIT
compose down --volumes --remove-orphans >/dev/null 2>&1 || true
compose pull
compose up -d
wait_ready
"$PACK_DIR/scripts/verify-inner"
tracer_output="$("$PACK_DIR/scripts/run-tracer")"
grep -F 'FLC-04 Azure golden path: PASS' <<<"$tracer_output" >/dev/null
result="${tracer_output%%$'\n'*}"
image_id="$(compose images -q floci-az | head -n1)"
receipt="$ARTIFACT_DIR/completion-receipt.md"
cat > "$receipt" <<EOF2
# Azure Provider Completion Receipt

- Provider: Azure
- Floci image: \`${FLOCI_AZ_IMAGE:-floci/floci-az:0.10.0}\`
- Container image ID: \`$image_id\`
- Endpoint: \`$FLOCI_AZ_ENDPOINT\`
- Credential mode: runtime-generated non-secret SharedKey in an Azurite-compatible local connection string
- Fixture: Blob input -> explicit Queue work item -> host worker -> Blob result
- Result: \`$result\`
- Fidelity ledger: \`engineering/development_packs/floci/azure/FIDELITY_LEDGER.md\`
- Provider-only proof: Azure identity/RBAC, SharedKey verification, account limits, regional behavior, durability, billing, and managed-service timing are not verified.
- Real-provider mutation: no
EOF2
test -s "$receipt"
grep -F -- '- Provider: Azure' "$receipt" >/dev/null
grep -F -- '- Result: `' "$receipt" >/dev/null
grep -F -- '- Real-provider mutation: no' "$receipt" >/dev/null
compose down --volumes --remove-orphans
trap - EXIT
printf 'FLC-04 Azure completion gate: PASS\n'
