expect_failure "$prepared_repo" m0/loadout-01-implement-change-plan "non-Kiln M0 namespace branch (loadout)" \
  "does not use an approved branch class"
expect_failure "$prepared_repo" m0/bench-01-role-qualification "non-Kiln M0 namespace branch (bench)" \
