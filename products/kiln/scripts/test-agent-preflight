  "does not use an approved branch class"
expect_failure "$prepared_repo" m0/temper-01-projection "non-Kiln M0 namespace branch (temper)" \
  "does not use an approved branch class"
expect_failure "$prepared_repo" m0/sys-01-governance "non-Kiln M0 namespace branch (sys)" \
  "does not use an approved branch class"

# 10. arbitrary m0/* branch → FAIL
expect_failure "$prepared_repo" m0/foo "arbitrary m0/* branch" \
  "does not use an approved branch class"
expect_failure "$prepared_repo" m0/anything-here "arbitrary m0/* branch" \
  "does not use an approved branch class"

# 11. Existing legacy work/p... fixtures continue to behave identically.
# (Covered by all prior tests in this file: valid, untracked, local-record,
# branch-issued, arbitrary-owner, proposed, missing-record, digest mismatch,
# revoked, malformed-base, wrong-order, invalid-time, whitespace-owner,
