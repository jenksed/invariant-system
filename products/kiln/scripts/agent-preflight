#!/usr/bin/env bash
set -euo pipefail

fail() {
  printf 'agent-preflight: %s\n' "$1" >&2
  exit 1
}

sha256_blob() {
  local blob=$1

  if command -v sha256sum >/dev/null 2>&1; then
    git cat-file blob "$blob" | sha256sum | awk '{print $1}'
  elif command -v shasum >/dev/null 2>&1; then
    git cat-file blob "$blob" | shasum -a 256 | awk '{print $1}'
  else
    fail "sha256sum or shasum is required to validate plan authorization"
  fi
}

validate_rfc3339() {
  local timestamp=$1
  local year month day hour minute second zone zone_hour zone_minute max_day

  [[ "$timestamp" =~ ^([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}):([0-9]{2})(Z|[+-]([0-9]{2}):([0-9]{2}))$ ]] || return 1

  year=$((10#${BASH_REMATCH[1]}))
  month=$((10#${BASH_REMATCH[2]}))
  day=$((10#${BASH_REMATCH[3]}))
  hour=$((10#${BASH_REMATCH[4]}))
  minute=$((10#${BASH_REMATCH[5]}))
  second=$((10#${BASH_REMATCH[6]}))
  zone=${BASH_REMATCH[7]}

  ((year >= 1 && month >= 1 && month <= 12 && day >= 1 && hour <= 23 && minute <= 59 && second <= 60)) || return 1

  case "$month" in
    1|3|5|7|8|10|12) max_day=31 ;;
    4|6|9|11) max_day=30 ;;
    2)
      max_day=28
      if ((year % 400 == 0 || (year % 4 == 0 && year % 100 != 0))); then
        max_day=29
      fi
      ;;
  esac

  ((day <= max_day)) || return 1

  if [[ "$zone" != "Z" ]]; then
    zone_hour=$((10#${BASH_REMATCH[8]}))
    zone_minute=$((10#${BASH_REMATCH[9]}))
    ((zone_hour <= 23 && zone_minute <= 59)) || return 1
  fi
}

find_authority_source() {
  local trusted_ref=$1
  local plan_path=$2
  local authorization=$3
  local plan_blob=$4
  local authorization_blob=$5
  local candidate candidate_plan_blob candidate_authorization_blob

  while IFS= read -r candidate; do
    candidate_plan_blob=$(git rev-parse "$candidate:$plan_path" 2>/dev/null || true)
    candidate_authorization_blob=$(git rev-parse "$candidate:$authorization" 2>/dev/null || true)

    if [[ "$candidate_plan_blob" == "$plan_blob" && "$candidate_authorization_blob" == "$authorization_blob" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done < <(git rev-list "$trusted_ref" -- "$plan_path" "$authorization")

  return 1
}

validate_authorization() {
  local plan_path=$1
  local authorization="./docs/authorizations/${work_id}.authorization"
  local trusted_ref="refs/remotes/origin/main"
  local trusted_owners="./docs/authorizations/TRUSTED-OWNERS"
  local line key value line_count=0
  local record_work_id="" state="" owner="" base_sha="" plan_sha256="" authorized_at="" scope=""
  local plan_blob authorization_blob
  local trusted_plan_blob trusted_authorization_blob authority_source
  local expected_keys=(work_id state owner base_sha plan_sha256 authorized_at scope)

  grep -Eq '^\*\*Status:\*\* Accepted([[:space:](]|$)' < <(git show "$implementation_commit:$plan_path") ||
    fail "$plan_path is not Accepted; proposed or ambiguous lifecycle state cannot authorize implementation"

  git cat-file -e "$implementation_commit:$authorization" 2>/dev/null ||
    fail "implementation authorization is missing from implementation commit $implementation_commit: $authorization"
  git rev-parse --verify --quiet "${trusted_ref}^{commit}" >/dev/null ||
    fail "trusted authority ref is unavailable: $trusted_ref"

  plan_blob=$(git rev-parse "$implementation_commit:$plan_path" 2>/dev/null || true)
  authorization_blob=$(git rev-parse "$implementation_commit:$authorization" 2>/dev/null || true)
  trusted_plan_blob=$(git rev-parse "$trusted_ref:$plan_path" 2>/dev/null || true)
  trusted_authorization_blob=$(git rev-parse "$trusted_ref:$authorization" 2>/dev/null || true)

  [[ -n "$plan_blob" ]] ||
    fail "$plan_path is not committed in implementation commit $implementation_commit"
  [[ -n "$authorization_blob" ]] ||
    fail "$authorization is not committed in implementation commit $implementation_commit"
  [[ "$plan_blob" == "$trusted_plan_blob" ]] ||
    fail "$plan_path is not identical to trusted Repository authority at $trusted_ref"
  [[ "$authorization_blob" == "$trusted_authorization_blob" ]] ||
    fail "$authorization is not identical to trusted Repository authority at $trusted_ref"

  authority_source=$(find_authority_source "$trusted_ref" "$plan_path" "$authorization" "$plan_blob" "$authorization_blob") ||
    fail "no trusted authority-source commit contains the exact plan and authorization record"
  git merge-base --is-ancestor "$authority_source" "$implementation_commit" ||
    fail "authorization source $authority_source is not an ancestor of implementation commit $implementation_commit"

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_count=$((line_count + 1))
    [[ "$line" == *=* ]] || fail "$authorization line $line_count is not key=value data"
    key=${line%%=*}
    value=${line#*=}

    ((line_count <= ${#expected_keys[@]})) ||
      fail "$authorization must contain exactly ${#expected_keys[@]} records; found more"
    [[ "$key" == "${expected_keys[$((line_count - 1))]}" ]] ||
      fail "$authorization line $line_count must use key ${expected_keys[$((line_count - 1))]}; found $key"

    case "$key" in
      work_id)
        [[ -z "$record_work_id" ]] || fail "$authorization repeats key: work_id"
        record_work_id=$value
        ;;
      state)
        [[ -z "$state" ]] || fail "$authorization repeats key: state"
        state=$value
        ;;
      owner)
        [[ -z "$owner" ]] || fail "$authorization repeats key: owner"
        owner=$value
        ;;
      base_sha)
        [[ -z "$base_sha" ]] || fail "$authorization repeats key: base_sha"
        base_sha=$value
        ;;
      plan_sha256)
        [[ -z "$plan_sha256" ]] || fail "$authorization repeats key: plan_sha256"
        plan_sha256=$value
        ;;
      authorized_at)
        [[ -z "$authorized_at" ]] || fail "$authorization repeats key: authorized_at"
        authorized_at=$value
        ;;
      scope)
        [[ -z "$scope" ]] || fail "$authorization repeats key: scope"
        scope=$value
        ;;
      *)
        fail "$authorization contains unknown key: $key"
        ;;
    esac
  done < <(git show "$implementation_commit:$authorization")

  [[ $line_count -eq ${#expected_keys[@]} ]] ||
    fail "$authorization must contain exactly ${#expected_keys[@]} records; found $line_count"
  [[ "$record_work_id" == "$work_id" ]] || fail "$authorization work_id does not match $work_id"
  [[ "$state" == "authorized" ]] || fail "$authorization state is not authorized"
  [[ "$owner" =~ [^[:space:]] ]] || fail "$authorization owner is empty or whitespace-only"
  [[ "$base_sha" =~ ^[0-9a-f]{40}$ ]] || fail "$authorization base_sha is not 40 lowercase hexadecimal characters"
  [[ "$plan_sha256" =~ ^[0-9a-f]{64}$ ]] || fail "$authorization plan_sha256 is not 64 lowercase hexadecimal characters"
  validate_rfc3339 "$authorized_at" || fail "$authorization authorized_at is not a valid RFC 3339 timestamp"
  [[ "$scope" =~ [^[:space:]] ]] || fail "$authorization scope is empty or whitespace-only"
  [[ "$(sha256_blob "$plan_blob")" == "$plan_sha256" ]] || fail "$authorization plan_sha256 does not match $plan_path"
  git cat-file -e "$trusted_ref:$trusted_owners" 2>/dev/null ||
    fail "trusted owner registry is unavailable at $trusted_ref:$trusted_owners"
  git show "$trusted_ref:$trusted_owners" | grep -Fqx -- "$owner" ||
    fail "$authorization owner is not registered in trusted Repository authority"
  git cat-file -e "${base_sha}^{commit}" 2>/dev/null || fail "$authorization base_sha is not a Repository commit"
  git merge-base --is-ancestor "$base_sha" "$authority_source" ||
    fail "$authorization base_sha is not an ancestor of authority source $authority_source"
}

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)
cd "$root"

# The kiln repo may live inside a monorepo, in which case its plans
# and authorizations live under `products/kiln/docs/...` in the
# commit tree while the script `cd`s into `products/kiln/`. Prefix
# every commit-tree path with `./` so `git show <commit>:./<path>`
# resolves relative to the script's cwd in both layouts: the
# standalone kiln repo and the monorepo.
git_path() { printf './%s' "$1"; }

checkout_commit=$(git rev-parse --verify HEAD)
checked_out_branch=$(git branch --show-current)
if [[ -n "${KILN_BRANCH:-}" && -n "$checked_out_branch" && "$KILN_BRANCH" != "$checked_out_branch" ]]; then
  fail "KILN_BRANCH '$KILN_BRANCH' does not match checked-out branch '$checked_out_branch'"
fi
branch=${KILN_BRANCH:-$checked_out_branch}
[[ -n "$branch" ]] || fail "detached HEAD is not a valid implementation state"

implementation_commit_input=${KILN_IMPLEMENTATION_COMMIT:-HEAD}
if [[ -n "${KILN_IMPLEMENTATION_COMMIT:-}" && ! "$KILN_IMPLEMENTATION_COMMIT" =~ ^[0-9a-f]{40}$ ]]; then
  fail "KILN_IMPLEMENTATION_COMMIT must be an exact 40-character lowercase commit SHA"
fi
implementation_commit=$(git rev-parse --verify "${implementation_commit_input}^{commit}" 2>/dev/null) ||
  fail "implementation commit does not resolve: $implementation_commit_input"
if [[ -n "${KILN_IMPLEMENTATION_COMMIT:-}" && "$implementation_commit" != "$KILN_IMPLEMENTATION_COMMIT" ]]; then
  fail "KILN_IMPLEMENTATION_COMMIT resolved to unexpected commit $implementation_commit"
fi
if [[ -n "$checked_out_branch" && "$implementation_commit" != "$checkout_commit" ]]; then
  fail "named checkout $checked_out_branch must validate its own HEAD $checkout_commit"
fi

case "$branch" in
  main|master|develop)
    fail "implementation work must not run on $branch"
    ;;
esac

case "$branch" in
  work/*|fix/*|spike/*|docs/*|chore/*|release/*|hotfix/*|agent/bootstrap-project-foundation)
    ;;
  m0/kiln-[0-9][0-9]-*)
    ;;
  *)
    fail "branch '$branch' does not use an approved branch class"
    ;;
esac

required_files=(
  AGENTS.md
  docs/PROJECT-INVARIANTS.md
  docs/AGENT-FRIENDLY-CODEBASE.md
  docs/ENGINEERING-QUALITY-RULES.md
)

for path in "${required_files[@]}"; do
  [[ -f "$path" ]] || fail "required project context is missing: $path"
done

plan=""
work_id=""
work_kind=""

if [[ "$branch" =~ ^work/(p[0-9]+-w[0-9]{2})-[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  work_id=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')
  work_kind="planning"
elif [[ "$branch" =~ ^work/(p[0-9]+-s[0-9]{2}-t[0-9]{2})-[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  work_id=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')
  work_kind="ticket"
elif [[ "$branch" =~ ^work/(p[0-9]+-s[0-9]{2})-[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  work_id=$(printf '%s' "${BASH_REMATCH[1]}" | tr '[:lower:]' '[:upper:]')
  work_kind="slice"
elif [[ "$branch" =~ ^m0/kiln-([0-9]{2})-[a-z0-9]+(-[a-z0-9]+)*$ ]]; then
  work_id="KILN-M0-${BASH_REMATCH[1]}"
  work_kind="m0"
elif [[ "$branch" == work/* ]]; then
  fail "work branch '$branch' must match work/p<phase>-w<two-digits>-<purpose>, work/p<phase>-s<two-digits>-t<two-digits>-<purpose>, or work/p<phase>-s<two-digits>-<purpose>"
elif [[ "$branch" == m0/kiln-* ]]; then
  fail "m0 branch '$branch' must match m0/kiln-<two-digit-work-number>-<purpose> (KILN M0 namespace only)"
fi

if [[ -n "$work_id" ]]; then
  candidates=()
  while IFS= read -r candidate; do
    candidates+=("$candidate")
  done < <(git ls-tree -r --name-only "$implementation_commit" -- "./docs/work" | grep -E "^docs/work/${work_id}-.*\\.md$" || true)

  if [[ ${#candidates[@]} -eq 0 ]]; then
    shopt -s nullglob
    working_tree_candidates=(docs/work/"${work_id}"-*.md)
    shopt -u nullglob
    if [[ ${#working_tree_candidates[@]} -gt 0 ]]; then
      fail "${working_tree_candidates[0]} is not committed in implementation commit $implementation_commit"
    fi
  fi
  plans=()

  for candidate in "${candidates[@]}"; do
    basename=$(basename "$candidate")

    if [[ "$work_kind" == "slice" && "$basename" =~ ^${work_id}-T[0-9]{2}- ]]; then
      continue
    fi

    plans+=("$candidate")
  done

[[ ${#plans[@]} -eq 1 ]] || fail "expected one plan for $work_id; found ${#plans[@]}"
plan="./${plans[0]}"

  grep -Fq "**Branch:** \`$branch\`" < <(git show "$implementation_commit:$plan") ||
    fail "$plan does not identify branch $branch in implementation commit $implementation_commit"

  required_headings=(
    "Objective"
    "Observed current state"
    "Assumptions and unknowns"
    "Requirements"
    "Proposed changes"
    "Expected files or components"
    "Acceptance criteria"
    "Deterministic verification"
    "Required completion Evidence"
    "Explicit exclusions"
    "Completion record"
  )

  if [[ "$work_kind" == "ticket" ]]; then
    required_headings+=(
      "Slice contribution"
      "Security boundary"
      "Demo contribution"
    )
  fi

  for heading in "${required_headings[@]}"; do
    grep -iFqx "## $heading" < <(git show "$implementation_commit:$plan") || fail "$plan is missing heading: $heading"
  done

  if [[ "$work_kind" == "ticket" || "$work_kind" == "slice" || "$work_kind" == "m0" ]]; then
    validate_authorization "$plan"

    if [[ "$work_kind" == "ticket" || "$work_kind" == "slice" ]]; then
      while IFS= read -r gate_id; do
        [[ -z "$gate_id" ]] && continue
        grep -Fq "| $gate_id |" docs/SLICE-ACCEPTANCE-GATES.md ||
          fail "$plan references unregistered slice gate: $gate_id"
      done < <(git show "$implementation_commit:$plan" | grep -oE 'P[0-9]+-S[0-9]{2}-G[0-9]{2}' | sort -u)
    fi
  fi
fi

printf 'agent-preflight: pass\n'
printf 'repository: %s\n' "$root"
printf 'branch: %s\n' "$branch"
printf 'checkout commit: %s\n' "$checkout_commit"
printf 'validated commit: %s\n' "$implementation_commit"

if [[ -n "$plan" ]]; then
  printf 'work kind: %s\n' "$work_kind"
  printf 'work package: %s\n' "$work_id"
  printf 'plan: %s\n' "$plan"
fi

if [[ -n "$(git status --porcelain)" ]]; then
  printf 'working tree: dirty\n'
else
  printf 'working tree: clean\n'
fi
