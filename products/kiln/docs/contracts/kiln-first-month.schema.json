{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.local/contracts/kiln-first-month.schema.json",
  "title": "Kiln first-month conformance contracts",
  "description": "Conformance-only subset accepted by P0-W21 through P0-W25. This Schema is not runtime implementation, persistence layout, authority, or proof of product behavior.",
  "oneOf": [
    {"$ref": "#/$defs/run_projection"},
    {"$ref": "#/$defs/context_manifest"},
    {"$ref": "#/$defs/patch_manifest"},
    {"$ref": "#/$defs/approval"},
    {"$ref": "#/$defs/command_registration"},
    {"$ref": "#/$defs/command_result"},
    {"$ref": "#/$defs/evidence"},
    {"$ref": "#/$defs/criterion_evaluation"},
    {"$ref": "#/$defs/receipt"},
    {"$ref": "#/$defs/cli_result"}
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_projection": {
      "type": "object",
      "required": ["kind", "session_id", "run_id", "run_state", "workflow_step", "operation_state", "revision"],
      "properties": {
        "kind": {"const": "run_projection"},
        "session_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "run_state": {
          "enum": ["ready", "running", "waiting_for_user", "orphaned", "completed", "failed", "canceled"]
        },
        "workflow_step": {
          "enum": ["intent", "investigation", "proposal", "approval", "application", "verification", "acceptance", "reconciliation"]
        },
        "operation_state": {
          "type": ["string", "null"],
          "enum": ["intent_recorded", "started", "succeeded", "failed", "canceled", "unknown", null]
        },
        "revision": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "context_manifest": {
      "type": "object",
      "required": ["kind", "provider", "model", "estimated_input_tokens", "tool_names", "package_digest"],
      "properties": {
        "kind": {"const": "context_manifest"},
        "provider": {"const": "minimax"},
        "model": {"const": "MiniMax-M3"},
        "estimated_input_tokens": {"type": "integer", "minimum": 0, "maximum": 32000},
        "tool_names": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["repo.search", "repo.read", "artifact.read", "change.propose"]}
        },
        "package_digest": {"$ref": "#/$defs/digest"},
        "fallback": {"const": false}
      },
      "additionalProperties": false
    },
    "patch_operation": {
      "type": "object",
      "required": ["operation_index", "operation_kind", "path", "before_digest", "after_digest"],
      "properties": {
        "operation_index": {"type": "integer", "minimum": 0, "maximum": 31},
        "operation_kind": {"enum": ["add", "replace", "delete"]},
        "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "before_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "after_digest": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]}
      },
      "additionalProperties": false
    },
    "patch_manifest": {
      "type": "object",
      "required": ["kind", "patch_id", "base_repository_state_digest", "operations", "patch_digest", "total_after_image_bytes"],
      "properties": {
        "kind": {"const": "patch_manifest"},
        "patch_id": {"type": "string", "minLength": 1},
        "base_repository_state_digest": {"$ref": "#/$defs/digest"},
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/patch_operation"}
        },
        "patch_digest": {"$ref": "#/$defs/digest"},
        "total_after_image_bytes": {"type": "integer", "minimum": 0, "maximum": 4194304}
      },
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["kind", "approval_id", "patch_digest", "base_repository_state_digest", "status", "actor_kind", "expires_at"],
      "properties": {
        "kind": {"const": "approval"},
        "approval_id": {"type": "string", "minLength": 1},
        "patch_digest": {"$ref": "#/$defs/digest"},
        "base_repository_state_digest": {"$ref": "#/$defs/digest"},
        "status": {"enum": ["active", "consumed", "invalidated", "expired"]},
        "actor_kind": {"const": "local_user"},
        "expires_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "command_registration": {
      "type": "object",
      "required": ["kind", "command_id", "executable_path", "shell", "network_requirement", "registration_digest"],
      "properties": {
        "kind": {"const": "command_registration"},
        "command_id": {"type": "string", "minLength": 1},
        "executable_path": {"type": "string", "pattern": "^/"},
        "shell": {"const": false},
        "network_requirement": {"enum": ["not_required", "required"]},
        "registration_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "command_result": {
      "type": "object",
      "required": ["kind", "command_result_id", "status", "process_group_cleanup", "result_digest"],
      "properties": {
        "kind": {"const": "command_result"},
        "command_result_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["succeeded", "failed", "timed_out", "canceled", "blocked", "unknown"]},
        "process_group_cleanup": {"enum": ["proved_gone", "not_started", "unknown"]},
        "result_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["kind", "evidence_id", "criterion_id", "status", "freshness", "completeness", "contradiction", "repository_state_digest", "record_digest"],
      "properties": {
        "kind": {"const": "evidence"},
        "evidence_id": {"type": "string", "minLength": 1},
        "criterion_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "fail", "blocked", "unknown"]},
        "freshness": {"enum": ["current", "stale", "unknown"]},
        "completeness": {"enum": ["complete", "partial", "truncated", "missing", "unknown"]},
        "contradiction": {"enum": ["none", "present", "unknown"]},
        "repository_state_digest": {"$ref": "#/$defs/digest"},
        "record_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "criterion_evaluation": {
      "type": "object",
      "required": ["kind", "criterion_id", "result", "repository_state_digest", "evaluation_digest"],
      "properties": {
        "kind": {"const": "criterion_evaluation"},
        "criterion_id": {"type": "string", "minLength": 1},
        "result": {"enum": ["pass", "fail", "blocked", "unknown", "stale", "contradicted"]},
        "repository_state_digest": {"$ref": "#/$defs/digest"},
        "evaluation_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "receipt": {
      "type": "object",
      "required": ["kind", "receipt_id", "completion_record_reference", "authority", "manifest_digest"],
      "properties": {
        "kind": {"const": "receipt"},
        "receipt_id": {"type": "string", "minLength": 1},
        "completion_record_reference": {"type": "string", "minLength": 1},
        "authority": {"const": false},
        "manifest_digest": {"$ref": "#/$defs/digest"}
      },
      "additionalProperties": false
    },
    "cli_result": {
      "type": "object",
      "required": ["kind", "schema", "command", "status", "exit_code", "errors", "warnings", "next_actions"],
      "properties": {
        "kind": {"const": "cli_result"},
        "schema": {"const": "kiln.cli.result/v1"},
        "command": {"type": "string", "minLength": 1},
        "status": {"enum": ["ok", "denied", "blocked", "stale", "failed", "unknown", "unsupported"]},
        "exit_code": {"enum": [0, 2, 3, 4, 5, 6, 7, 8, 9, 10]},
        "errors": {"type": "array"},
        "warnings": {"type": "array"},
        "next_actions": {"type": "array"},
        "data": {"type": ["object", "array", "null"]},
        "session_revision": {"type": ["integer", "null"], "minimum": 0},
        "journal_digest": {"type": ["string", "null"]},
        "emitted_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
