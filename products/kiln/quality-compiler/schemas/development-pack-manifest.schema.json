{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.local/schemas/development-pack-manifest.schema.json",
  "title": "Kiln Development Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "protocol_versions",
    "display_name",
    "pack_digest",
    "operations",
    "limits",
    "trust_class"
  ],
  "properties": {
    "schema": {
      "const": "kiln.development_pack.manifest/v1alpha1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "protocol_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^kiln\\.development_pack/v[0-9]+(?:alpha[0-9]+)?$"
      }
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "pack_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "executable_identity": {
      "type": [
        "object",
        "null"
      ]
    },
    "project_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "describe",
          "detect",
          "plan",
          "parse",
          "impact",
          "policy_metadata"
        ]
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_request_bytes",
        "maximum_response_bytes"
      ],
      "properties": {
        "maximum_request_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "maximum_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 67108864
        }
      }
    },
    "trust_class": {
      "enum": [
        "bundled",
        "reviewed",
        "untrusted"
      ]
    },
    "effects": {
      "$ref": "#/$defs/effects"
    }
  },
  "$defs": {
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reads_source": {
          "type": "boolean"
        },
        "loads_project_code": {
          "type": "boolean"
        },
        "executes_project_code": {
          "type": "boolean"
        },
        "writes_cache": {
          "type": "boolean"
        },
        "requires_network": {
          "enum": [
            "no",
            "yes",
            "unknown"
          ]
        },
        "requires_secrets": {
          "type": "boolean"
        },
        "mutates_repository": {
          "const": false
        }
      }
    }
  }
}
