{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.local/schemas/verification-obligation.schema.json",
  "title": "Kiln Verification Obligation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "claim_id",
    "statement",
    "accepted_methods",
    "required_guarantee",
    "minimum_assurance",
    "freshness_rule"
  ],
  "properties": {
    "schema": {
      "const": "kiln.quality.verification_obligation/v1alpha1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accepted_methods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_guarantee": {
      "$ref": "#/$defs/guarantee"
    },
    "minimum_completeness": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "minimum_assurance": {
      "enum": [
        "rapid",
        "standard",
        "thorough",
        "critical",
        "formal"
      ]
    },
    "freshness_rule": {
      "type": "string",
      "minLength": 1
    },
    "fallback": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "guarantee": {
      "enum": [
        "proof",
        "sound_for_pass",
        "sound_for_failure",
        "bounded_sound_for_pass",
        "bounded_sound_for_failure",
        "empirical",
        "heuristic",
        "human_observation",
        "unknown"
      ]
    }
  }
}
