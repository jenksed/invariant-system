{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiln.local/schemas/quality-observation.schema.json",
  "title": "Kiln Quality Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "subject_digest",
    "producer",
    "method",
    "status",
    "completeness",
    "observed_at"
  ],
  "properties": {
    "schema": {
      "const": "kiln.quality.observation/v1alpha1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "blocked",
        "unknown",
        "canceled",
        "timed_out"
      ]
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "truncated",
        "missing",
        "unknown"
      ]
    },
    "artifact_references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
