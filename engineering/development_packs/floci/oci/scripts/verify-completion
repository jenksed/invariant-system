#!/usr/bin/env bash
set -euo pipefail
source "$(dirname "$0")/common.sh"
guard_endpoint
mkdir -p "$ARTIFACT_DIR"
trap 'compose logs >"$ARTIFACT_DIR/floci-oci.log" 2>&1 || true' EXIT
compose down --volumes --remove-orphans >/dev/null 2>&1 || true
compose pull
compose up -d
wait_ready
"$PACK_DIR/scripts/verify-inner"
result="$("$PACK_DIR/scripts/run-tracer" | head -n1)"
image_id="$(compose images -q floci-oci | head -n1)"
cat > "$ARTIFACT_DIR/completion-receipt.md" <<EOF2
# OCI Provider Completion Receipt

- Provider: OCI
- Floci image: \`${FLOCI_OCI_IMAGE:-floci/floci-oci:0.2.0}\`
- Container image ID: \`$image_id\`
- Endpoint: \`$FLOCI_OCI_ENDPOINT\`
- Namespace: \`$FLOCI_OCI_NAMESPACE\`
- Tenancy context: \`$FLOCI_OCI_TENANCY\`
- Credential mode: unsigned local requests mapped to the synthetic/default tenancy; signature enforcement disabled for this tracer
- Fixture: Object Storage namespace -> source bucket/object -> deterministic result bucket/object
- Result: \`$result\`
- Fidelity ledger: \`engineering/development_packs/floci/oci/FIDELITY_LEDGER.md\`
- Provider-only proof: signature enforcement, IAM policy, compartments, quotas, regional durability, billing, and managed-service timing are not verified.
- Real-provider mutation: no
EOF2
compose down --volumes --remove-orphans
trap - EXIT
printf 'FLC-04 OCI completion gate: PASS\n'
