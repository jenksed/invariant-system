#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=iac-common.sh
source "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/iac-common.sh"

command="${1:-}"
name="${2:-}"
tool="${3:-}"
namespace="${4:-}"
[[ "$command" == "save" || "$command" == "load" ]] || { echo "usage: snapshot-cache save|load <name> <terraform|opentofu> <namespace>" >&2; exit 64; }
[[ -n "$name" && -n "$tool" && -n "$namespace" ]] || { echo "snapshot name, tool, and namespace are required" >&2; exit 64; }

ensure_iac_env
meta_dir="$IAC_ARTIFACT_DIR/snapshots"
meta="$meta_dir/${name}.json"
mkdir -p "$meta_dir"

tool_image="$(iac_image "$tool")"
fixture_digest="$(sha256_paths "$IAC_DIR/terraform" "$AWS_PACK_DIR/docker-compose.floci.yml" "$AWS_PACK_DIR/env.floci.example")"
cache_key="$(python3 - "$FLOCI_IMAGE" "$tool" "$tool_image" "$AWS_PROVIDER_VERSION" "$fixture_digest" <<'PY'
import hashlib, sys
print(hashlib.sha256("\n".join(sys.argv[1:]).encode()).hexdigest())
PY
)"

snapshot_endpoint_unavailable() {
  local status="$1"
  local body="$2"

  [[ "$status" == "404" || "$status" == "405" ]] && return 0

  # Floci AWS 1.5.34 has no /_floci/snapshots controller. The request falls
  # through to S3, which returns this exact InvalidArgument family. Treat only
  # that known routing signature as "capability unavailable"; other 4xx/5xx
  # responses remain real failures so a broken snapshot implementation cannot
  # be silently downgraded to a skip.
  if [[ "$status" == "400" ]] \
    && grep -Fq '<Code>InvalidArgument</Code>' "$body" \
    && grep -Fq 'POST requires either ?uploads, ?uploadId, ?restore or ?select parameter.' "$body"; then
    return 0
  fi

  return 1
}

snapshot_post() {
  local path="$1"
  local label="$2"
  local allow_unavailable="${3:-false}"
  local body="$IAC_ARTIFACT_DIR/${label}.response"
  local status
  status="$(curl -sS \
    -o "$body" \
    -w '%{http_code}' \
    -H 'Content-Type: application/json' \
    -X POST \
    --data '{}' \
    "$AWS_ENDPOINT_URL$path")"

  if [[ "$status" =~ ^2[0-9][0-9]$ ]]; then
    cat "$body"
    return 0
  fi

  if [[ "$allow_unavailable" == "true" ]] && snapshot_endpoint_unavailable "$status" "$body"; then
    printf 'Floci snapshot capability unavailable: %s HTTP %s\n' "$path" "$status" >&2
    cat "$body" >&2 || true
    return 78
  fi

  printf 'Floci snapshot request failed: %s HTTP %s\n' "$path" "$status" >&2
  cat "$body" >&2 || true
  return 1
}

if [[ "$command" == "save" ]]; then
  if snapshot_post "/_floci/snapshots/$name" "snapshot-save-${name}" true >/dev/null; then
    :
  else
    rc=$?
    exit "$rc"
  fi

  python3 - "$meta" "$cache_key" "$FLOCI_IMAGE" "$tool" "$tool_image" "$AWS_PROVIDER_VERSION" "$fixture_digest" "$namespace" <<'PY'
import json, sys
path, key, floci, tool, image, provider, fixture, namespace = sys.argv[1:]
with open(path, "w", encoding="utf-8") as f:
    json.dump({
        "cache_key": key,
        "floci_image": floci,
        "iac_engine": tool,
        "iac_image": image,
        "aws_provider_version": provider,
        "fixture_digest": fixture,
        "namespace": namespace,
    }, f, indent=2, sort_keys=True)
    f.write("\n")
PY
  printf 'Floci snapshot saved: %s key=%s\n' "$name" "$cache_key"
  exit 0
fi

[[ -f "$meta" ]] || { echo "snapshot metadata missing: $meta" >&2; exit 1; }
stored_key="$(python3 - "$meta" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8"))["cache_key"])
PY
)"
[[ "$stored_key" == "$cache_key" ]] || {
  printf 'refusing stale Floci snapshot %s: stored key %s current key %s\n' "$name" "$stored_key" "$cache_key" >&2
  exit 1
}

snapshot_post "/_floci/snapshots/$name/load" "snapshot-load-${name}" >/dev/null
assert_iac_present "$namespace"
printf 'Floci snapshot restored with matching provenance: %s key=%s\n' "$name" "$cache_key"
