#!/usr/bin/env python3
from __future__ import annotations

import json
from pathlib import Path
import shutil
import sys

root = Path(sys.argv[1] if len(sys.argv) > 1 else ".").resolve()
if not root.is_dir():
    raise SystemExit(f"not a directory: {root}")

SKIP = {".git", ".terraform", ".tofu", "node_modules", "vendor", ".venv", "venv"}

def files_named(suffixes):
    found = []
    for p in root.rglob("*"):
        if any(part in SKIP for part in p.parts):
            continue
        if p.is_file() and p.suffix.lower() in suffixes:
            found.append(str(p.relative_to(root)))
    return sorted(found)

tf_files = files_named({".tf"})
yaml_json = files_named({".yaml", ".yml", ".json", ".template"})
cloudformation = []
for rel in yaml_json:
    p = root / rel
    try:
        text = p.read_text(encoding="utf-8", errors="ignore")[:200000]
    except OSError:
        continue
    if "AWSTemplateFormatVersion" in text or "AWS::" in text:
        cloudformation.append(rel)

lock_files = sorted(str(p.relative_to(root)) for p in root.rglob(".terraform.lock.hcl") if not any(part in SKIP for part in p.parts))
backend_hints = []
for rel in tf_files:
    text = (root / rel).read_text(encoding="utf-8", errors="ignore")
    if 'backend "' in text:
        backend_hints.append(rel)

print(json.dumps({
    "root": str(root),
    "terraform_cli": shutil.which("terraform"),
    "opentofu_cli": shutil.which("tofu"),
    "terraform_files": tf_files,
    "terraform_lock_files": lock_files,
    "backend_hints": sorted(backend_hints),
    "cloudformation_candidates": sorted(cloudformation),
    "github_actions_present": (root / ".github" / "workflows").is_dir(),
}, indent=2, sort_keys=True))
