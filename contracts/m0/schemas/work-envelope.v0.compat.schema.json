{
  "$id": "engineering-system/work-envelope/v0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority_requests": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capability": {
            "minLength": 1,
            "type": "string"
          },
          "scope": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "capability",
          "scope"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "capability": {
      "additionalProperties": false,
      "properties": {
        "contract_version": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "enum": [
            "repository-recon",
            "verify-change",
            "software-change"
          ]
        },
        "method_provenance": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "type": "array"
        }
      },
      "required": [
        "id",
        "contract_version",
        "method_provenance"
      ],
      "type": "object"
    },
    "constraints": {
      "additionalProperties": false,
      "properties": {
        "must": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "must_not": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "must",
        "must_not"
      ],
      "type": "object"
    },
    "context_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "created_at": {
      "type": "string"
    },
    "goal": {
      "additionalProperties": false,
      "properties": {
        "success_conditions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title",
        "success_conditions"
      ],
      "type": "object"
    },
    "producer": {
      "additionalProperties": false,
      "properties": {
        "product": {
          "const": "loadout"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "product",
        "version"
      ],
      "type": "object"
    },
    "project_state": {
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "repository": {
          "minLength": 1,
          "type": "string"
        },
        "workspace_state_digest": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "repository",
        "base_commit",
        "workspace_state_digest"
      ],
      "type": "object"
    },
    "proof_obligations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "minLength": 1,
            "type": "string"
          },
          "requirement": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "requirement"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema": {
      "const": "engineering-system/work-envelope/v0"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "excluded": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "included": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "included",
        "excluded"
      ],
      "type": "object"
    },
    "work_id": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "work_id",
    "producer",
    "goal",
    "capability",
    "project_state",
    "scope",
    "constraints",
    "proof_obligations",
    "authority_requests"
  ],
  "type": "object"
}
