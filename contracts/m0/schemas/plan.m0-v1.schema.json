{
  "$defs": {
    "artifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "type": "object"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "fixture_only": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "engineering-system/plan/m0-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_criteria": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "authority_requests": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "disclosure_boundary": {
      "enum": [
        "LOCAL_ONLY",
        "REMOTE_DISCLOSURE_ALLOWED_BY_MANIFEST"
      ],
      "type": "string"
    },
    "goal": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "type": "object"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "plan_id": {
      "type": "string"
    },
    "proof_obligations": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "safety_boundary": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "schema": {
      "const": "engineering-system/plan/m0-v1"
    },
    "scope": {
      "additionalProperties": false,
      "properties": {
        "excluded": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "included": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "included",
        "excluded"
      ],
      "type": "object"
    },
    "semantic_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "plan_id",
    "semantic_digest",
    "goal",
    "acceptance_criteria",
    "scope",
    "authority_requests",
    "proof_obligations",
    "safety_boundary",
    "disclosure_boundary"
  ],
  "type": "object"
}
