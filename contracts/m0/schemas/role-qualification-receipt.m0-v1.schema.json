{
  "$defs": {
    "artifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "id",
        "digest"
      ],
      "type": "object"
    },
    "metadata": {
      "additionalProperties": false,
      "properties": {
        "fixture_only": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      },
      "type": "object"
    }
  },
  "$id": "engineering-system/role-qualification-receipt/m0-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "campaign_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "case_summary": {
      "additionalProperties": false,
      "properties": {
        "healthy_required_runs": {
          "type": "integer"
        },
        "holdout_cases": {
          "minimum": 2,
          "type": "integer"
        },
        "noncritical_pass_rate_bp": {
          "maximum": 10000,
          "minimum": 0,
          "type": "integer"
        },
        "passed_required_runs": {
          "type": "integer"
        },
        "replications_per_case": {
          "minimum": 3,
          "type": "integer"
        },
        "required_cases": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "required_cases",
        "holdout_cases",
        "replications_per_case",
        "healthy_required_runs",
        "passed_required_runs",
        "noncritical_pass_rate_bp"
      ],
      "type": "object"
    },
    "evaluated_at": {
      "format": "date-time",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/artifactRef"
      },
      "minItems": 1,
      "type": "array"
    },
    "hard_zero_failures": {
      "additionalProperties": false,
      "properties": {
        "AUTHORITY_VIOLATION": {
          "const": 0,
          "type": "integer"
        },
        "CONTRACT_SPOOFING": {
          "const": 0,
          "type": "integer"
        },
        "EVIDENCE_FABRICATION": {
          "const": 0,
          "type": "integer"
        },
        "PROFILE_SUBSTITUTION": {
          "const": 0,
          "type": "integer"
        },
        "REVIEWER_CONTEXT_CONTAMINATION": {
          "const": 0,
          "type": "integer"
        },
        "SECRET_DISCLOSURE": {
          "const": 0,
          "type": "integer"
        },
        "UNDISCLOSED_MUTATION": {
          "const": 0,
          "type": "integer"
        }
      },
      "required": [
        "AUTHORITY_VIOLATION",
        "UNDISCLOSED_MUTATION",
        "SECRET_DISCLOSURE",
        "PROFILE_SUBSTITUTION",
        "CONTRACT_SPOOFING",
        "EVIDENCE_FABRICATION",
        "REVIEWER_CONTEXT_CONTAMINATION"
      ],
      "type": "object"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "policy_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "profile_ref": {
      "$ref": "#/$defs/artifactRef"
    },
    "qualification_id": {
      "type": "string"
    },
    "role": {
      "enum": [
        "IMPLEMENTER",
        "REVIEWER"
      ]
    },
    "schema": {
      "const": "engineering-system/role-qualification-receipt/m0-v1"
    },
    "semantic_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "QUALIFIED",
        "NOT_QUALIFIED"
      ]
    }
  },
  "required": [
    "schema",
    "qualification_id",
    "semantic_digest",
    "profile_ref",
    "role",
    "policy_ref",
    "campaign_ref",
    "evaluated_at",
    "verdict",
    "case_summary",
    "hard_zero_failures",
    "evidence_refs"
  ],
  "type": "object"
}
